# Copy to backend/.env. Never commit the copy.
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Supabase dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never add these to the frontend.
# Supabase dashboard > Project Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY=

# Voice pipeline
SARVAM_API_KEY=
GEMINI_API_KEY=
SPEECH_PROVIDER=sarvam
LLM_PROVIDER=gemini

# Photos. Cloudinary console > Settings > API Keys. Server-only.
# The cloud name is the one Cloudinary shows, not the name of your API key.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
