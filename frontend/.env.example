# Copy to frontend/.env.local. Never commit the copy.
# With the Supabase values blank, `npm run dev` shows the dashboard with sample data.

# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only address of the backend API
API_URL=http://localhost:4000

# Shown on the privacy page so people can reach you.
NEXT_PUBLIC_CONTACT_EMAIL=

# Public site address, used for share links and QR codes.
SITE_URL=
